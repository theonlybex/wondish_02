generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Auth & Accounts ──────────────────────────────────────────────────────────

model Account {
  id                 String   @id @default(cuid())
  clerkId            String?  @unique
  email              String   @unique
  firstName          String
  lastName           String
  password           String   @default("")
  phone              String?
  photoUrl           String?
  isEnabled          Boolean  @default(true)
  agreedTerms        Boolean  @default(false)
  emailVerified      Boolean  @default(false)
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])

  roles             AccountRole[]
  patient           Patient?
  subscriptions     Subscription[]
  couponRedemptions   CouponRedemption[]
  restaurantStaff     RestaurantStaff[]
  restaurantReferrals RestaurantReferral[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  accounts    AccountRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  name  String           @unique
  roles RolePermission[]
}

model AccountRole {
  accountId String
  roleId    String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id])

  @@id([accountId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// ─── Subscriptions & Billing ──────────────────────────────────────────────────

model Subscription {
  id                     String             @id @default(cuid())
  accountId              String
  account                Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  source                 SubscriptionSource @default(STRIPE)
  stripeCustomerId       String?            @unique
  stripeSubscriptionId   String?            @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  plan                   SubscriptionPlan   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  trialEndsAt            DateTime?
  canceledAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  // One row per (account, source): a Stripe row and an Apple row can coexist
  // on the same account (D19); each source manages only its own row.
  @@unique([accountId, source])
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum SubscriptionSource {
  STRIPE
  APPLE
  COUPON
  ADMIN
}

// ─── Patient Profile ─────────────────────────────────────────────────────────

model Patient {
  id                 String            @id @default(cuid())
  accountId          String            @unique
  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  birthday           DateTime?
  sexAtBirth         String? // "MALE" or "FEMALE" – used for caloric formulas
  genderId           String?
  gender             Gender?           @relation(fields: [genderId], references: [id])
  weight             Float?
  weightUnit         String?           @default("lbs")
  height             Float? // stored in cm (converted from user input)
  heightUnit         String?           @default("ftin") // "cm" | "in" | "ftin"
  heightFt           Int? // feet component (when heightUnit = "ftin")
  heightIn           Float? // inches component (when heightUnit = "ftin")
  bmi                Float?
  physicalActivityId String?
  physicalActivity   PhysicalActivity? @relation(fields: [physicalActivityId], references: [id])
  mealTypeId         String?
  mealType           MealType?         @relation(fields: [mealTypeId], references: [id])
  goalWeight         Float?
  goalWeightUnit     String?           @default("lbs")
  weeklyGoal         Float? // kg per week
  mealPlanStartDate  DateTime?

  // Meal-plan reliability (Phase A)
  activePlanVersion    Int            @default(0)
  mealPlanStatus       MealPlanStatus @default(IDLE)
  mealPlanStale        Boolean        @default(false)
  mealPlanGenStartedAt DateTime?
  mealPlanError        String?
  mealPlanWeight       Float? // current weight (lbs) when the active plan was generated — used to detect drift

  foodPreferences   PatientFoodPreference[]
  foodToAvoid       PatientFoodToAvoid[]
  foodAllergies     PatientFoodAllergy[]
  healthConditions  PatientHealthCondition[]
  motivations       PatientMotivation[]
  dishPreferences   PatientDishPreference[]
  menus             Menu[]
  orders            Order[]
  journalEntries    JournalEntry[]
  customIngredients PatientCustomIngredient[]
  mealLogs          MealLog[]

  claraCapabilityRequests ClaraCapabilityRequest[]
  supplements             Supplement[]

  restaurantPlanExchanges RestaurantPlanExchange[]
  fridgePlanExchanges     FridgePlanExchange[]

  profileCompleted Boolean  @default(false)
  tasteCompleted   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Gender {
  id       String    @id @default(cuid())
  name     String    @unique
  patients Patient[]
}

model PhysicalActivity {
  id       String    @id @default(cuid())
  name     String    @unique
  level    Int       @default(1)
  patients Patient[]
}

model Motivation {
  id                String                       @id @default(cuid())
  name              String                       @unique
  patients          PatientMotivation[]
  bannedIngredients MotivationBannedIngredient[]
}

model MotivationBannedIngredient {
  id           String     @id @default(cuid())
  motivationId String
  motivation   Motivation @relation(fields: [motivationId], references: [id], onDelete: Cascade)
  name         String

  @@unique([motivationId, name])
}

model PatientMotivation {
  patientId    String
  motivationId String
  patient      Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  motivation   Motivation @relation(fields: [motivationId], references: [id])

  @@id([patientId, motivationId])
}

// ─── Food Preferences ─────────────────────────────────────────────────────────

model FoodPreference {
  id                String                           @id @default(cuid())
  name              String                           @unique
  patients          PatientFoodPreference[]
  bannedIngredients FoodPreferenceBannedIngredient[]
}

model FoodPreferenceBannedIngredient {
  id           String         @id @default(cuid())
  preferenceId String
  preference   FoodPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  name         String

  @@unique([preferenceId, name])
}

model PatientFoodPreference {
  patientId String
  foodId    String
  patient   Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  food      FoodPreference @relation(fields: [foodId], references: [id])

  @@id([patientId, foodId])
}

model FoodToAvoid {
  id       String               @id @default(cuid())
  name     String               @unique
  patients PatientFoodToAvoid[]
}

model PatientFoodToAvoid {
  patientId String
  foodId    String
  patient   Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  food      FoodToAvoid @relation(fields: [foodId], references: [id])

  @@id([patientId, foodId])
}

model FoodAllergy {
  id                String                        @id @default(cuid())
  name              String                        @unique
  patients          PatientFoodAllergy[]
  bannedIngredients FoodAllergyBannedIngredient[]
}

model FoodAllergyBannedIngredient {
  id        String      @id @default(cuid())
  allergyId String
  allergy   FoodAllergy @relation(fields: [allergyId], references: [id], onDelete: Cascade)
  name      String

  @@unique([allergyId, name])
}

model PatientFoodAllergy {
  patientId String
  foodId    String
  patient   Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  food      FoodAllergy @relation(fields: [foodId], references: [id])

  @@id([patientId, foodId])
}

model HealthCondition {
  id                String                            @id @default(cuid())
  name              String                            @unique
  patients          PatientHealthCondition[]
  bannedIngredients HealthConditionBannedIngredient[]
}

model HealthConditionBannedIngredient {
  id          String          @id @default(cuid())
  conditionId String
  condition   HealthCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  name        String

  @@unique([conditionId, name])
}

model PatientHealthCondition {
  patientId   String
  conditionId String
  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  condition   HealthCondition @relation(fields: [conditionId], references: [id])

  @@id([patientId, conditionId])
}

// ─── Dish Tinder Preferences ─────────────────────────────────────────────────

model PatientDishPreference {
  id        String   @id @default(cuid())
  patientId String
  recipeId  String
  liked     Boolean // true = would try, false = not gonna try
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([patientId, recipeId])
}

// ─── Custom Ingredients (Premium) ────────────────────────────────────────────

model PatientCustomIngredient {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  calories  Float?
  protein   Float?
  carbs     Float?
  fat       Float?
  unit      String?
  createdAt DateTime @default(now())
}

// ─── Recipes & Dishes ────────────────────────────────────────────────────────

model Recipe {
  id              String                  @id @default(cuid())
  name            String
  description     String?
  imageUrl        String?
  emoji           String?
  calories        Float?
  protein         Float?
  carbs           Float?
  fat             Float?
  fiber           Float?
  prepTime        Int?
  cookTime        Int?
  servings        Int?                    @default(1)
  isPublic        Boolean                 @default(true)
  tags            String[]
  family          String?
  subFamily       String?
  dishTypeId      String?
  dishType        DishType?               @relation(fields: [dishTypeId], references: [id])
  mealTypeId      String?
  mealType        MealType?               @relation(fields: [mealTypeId], references: [id])
  ethnicId        String?
  ethnic          Ethnic?                 @relation(fields: [ethnicId], references: [id])
  ingredients     RecipeIngredient[]
  menus           Menu[]
  dishPreferences PatientDishPreference[]
  mealLogs        MealLog[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model Ingredient {
  id             String                     @id @default(cuid())
  name           String                     @unique
  unit           String?
  calories       Float?
  protein        Float?
  carbs          Float?
  fat            Float?
  recipes        RecipeIngredient[]
  restaurantUses RestaurantDishIngredient[]
}

model RecipeIngredient {
  recipeId     String
  ingredientId String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Float?
  unit         String?

  @@id([recipeId, ingredientId])
}

model MealType {
  id               String           @id @default(cuid())
  name             String           @unique
  recipes          Recipe[]
  patients         Patient[]
  menus            Menu[]
  restaurantDishes RestaurantDish[]
}

model DishType {
  id               String           @id @default(cuid())
  name             String           @unique
  recipes          Recipe[]
  restaurantDishes RestaurantDish[]
}

model Ethnic {
  id          String       @id @default(cuid())
  name        String       @unique
  recipes     Recipe[]
  restaurants Restaurant[]
}

// ─── Restaurants ──────────────────────────────────────────────────────────────

enum RestaurantStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RestaurantDishStatus {
  DRAFT
  PENDING_REVIEW // staff publish awaiting ops approval (Phase 6a §7)
  PUBLISHED
}

model Restaurant {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String?
  imageUrl     String?
  logoUrl      String?
  addressLine  String?
  city         String?
  state        String?
  postalCode   String?
  neighborhood String // e.g. "Miracle Mile"
  latitude     Float? // nullable now; geo is Phase 7
  longitude    Float? // nullable now; geo is Phase 7

  ethnicId String? // primary cuisine; reuses the existing Ethnic model
  ethnic   Ethnic? @relation(fields: [ethnicId], references: [id])

  status    RestaurantStatus @default(DRAFT)
  hours     Json?
  phone     String?
  website   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  dishes        RestaurantDish[]
  staff         RestaurantStaff[]
  invites       RestaurantInvite[]
  auditLogs     RestaurantAuditLog[]
  dishRevisions RestaurantDishRevision[]
  qrCodes       RestaurantQrCode[]
  referrals     RestaurantReferral[]

  @@index([status, neighborhood])
}

model RestaurantDish {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Decimal?   @db.Decimal(10, 2)
  currency     String     @default("USD")
  section      String // e.g. "Mains"
  sortOrder    Int        @default(0)

  dishTypeId String?
  dishType   DishType? @relation(fields: [dishTypeId], references: [id])
  mealTypeId String?
  mealType   MealType? @relation(fields: [mealTypeId], references: [id])

  // Optional macros, whole-dish (not per-serving like Recipe/MealLog).
  calories Float?
  protein  Float?
  carbs    Float?
  fat      Float?
  fiber    Float?

  isRecommended  Boolean              @default(false)
  available      Boolean              @default(true)
  status         RestaurantDishStatus @default(DRAFT)
  // Phase 6a: stamped on staff publish/verify — drives menu freshness.
  lastVerifiedAt DateTime?
  // Phase 6a: staff removals soft-delete (MealLog provenance survives);
  // every serving query filters deletedAt: null.
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  ingredients   RestaurantDishIngredient[]
  mealLogs      MealLog[]
  planExchanges RestaurantPlanExchange[]
  revisions     RestaurantDishRevision[]

  @@index([restaurantId, status])
}

model RestaurantDishIngredient {
  dishId   String
  dish     RestaurantDish @relation(fields: [dishId], references: [id], onDelete: Cascade)
  name     String
  quantity Float?
  unit     String?

  // Phase 6a: optional link to the site ingredient catalog. `name` stays
  // the denormalized display string and the verdict input; free-text rows
  // (ingredientId null) remain valid and get mapped by ops later.
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])

  @@id([dishId, name])
}

// ─── Restaurant self-service (Phase 6a, design doc
// docs/restaurants/phase-6a-restaurant-admin-design.md) ──────────────────────

enum RestaurantStaffRole {
  OWNER // full control incl. staff management
  MANAGER // menu + profile edits
}

model RestaurantStaff {
  id           String              @id @default(cuid())
  accountId    String
  account      Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role         RestaurantStaffRole @default(MANAGER)
  invitedById  String? // Account.id of the inviter (admin or OWNER)
  createdAt    DateTime            @default(now())

  @@unique([accountId, restaurantId])
  @@index([restaurantId])
}

enum RestaurantInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model RestaurantInvite {
  id                String                 @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  email             String
  role              RestaurantStaffRole    @default(OWNER)
  status            RestaurantInviteStatus @default(PENDING)
  clerkInvitationId String? // set when Clerk sent the email
  invitedById       String // Account.id
  createdAt         DateTime               @default(now())
  acceptedAt        DateTime?

  @@index([restaurantId, status])
  @@index([email])
}

model RestaurantAuditLog {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  accountId    String // who acted (staff or SUPER)
  entity       String // "restaurant" | "dish" | "ingredients" | "staff" | "invite"
  entityId     String?
  action       String // "create" | "update" | "publish" | "revoke" | ...
  diff         Json?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

// Phase 6a M3 — review workflow (design §7). One row per staff submission
// that needs ops eyes: PUBLISH = first publish of a dish (the dish row
// itself is the payload, held in PENDING_REVIEW), EDIT = staged
// name/ingredient changes on a PUBLISHED dish (dish stays live on its old
// data until approval swaps the payload in).
enum DishRevisionKind {
  PUBLISH
  EDIT
}

enum DishRevisionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED // withdrawn by unpublish/delete, or superseded
}

model RestaurantDishRevision {
  id           String             @id @default(cuid())
  dishId       String
  dish         RestaurantDish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  restaurantId String // denormalized for queue + portal-banner queries
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kind         DishRevisionKind
  status       DishRevisionStatus @default(PENDING)
  submittedBy  String // Account.id

  // EDIT payload — null field = unchanged. PUBLISH rows carry no payload
  // (the dish row is reviewed as-is).
  name        String?
  ingredients Json? // [{ name, quantity, unit, ingredientId }]

  reviewNote String? // ops note (required on reject)
  reviewedBy String? // Account.id
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // NOTE: a partial unique index (not expressible in Prisma schema) enforces
  // at most one PENDING revision per dish — see migration
  // 20260807000000_revision_single_pending. Writers catch P2002 on create.
  @@index([status, createdAt])
  @@index([restaurantId, status, reviewedAt])
  @@index([dishId, status])
}

// Phase 3 §1 — a scannable code placed in a restaurant. One code or one per
// table; `label` is how ops tells them apart ("Table 7", "Front window").
// Counters are denormalised so the ops strip needs no aggregate scan.
model RestaurantQrCode {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  token        String     @unique // the value encoded in the QR image
  label        String
  active       Boolean    @default(true)
  scans        Int        @default(0)
  signups      Int        @default(0)
  createdAt    DateTime   @default(now())

  referrals RestaurantReferral[]

  @@index([restaurantId, active])
}

// Phase 3 §2 — the attribution spine: which restaurant earned which account.
// Unique per (account, restaurant) so a re-scan can never double-attribute.
// The QR pointer is nullable and SetNull: retiring a code must not erase the
// sign-ups it earned.
model RestaurantReferral {
  id                 String            @id @default(cuid())
  accountId          String
  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  restaurantId       String
  restaurant         Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantQrCodeId String?
  qrCode             RestaurantQrCode? @relation(fields: [restaurantQrCodeId], references: [id], onDelete: SetNull)
  signedUpAt         DateTime          @default(now())

  @@unique([accountId, restaurantId])
  @@index([restaurantId, signedUpAt])
}

enum IngredientRequestStatus {
  PENDING
  MAPPED
  REJECTED
}

model IngredientRequest {
  id           String                  @id @default(cuid())
  name         String
  restaurantId String
  requestedBy  String // Account.id
  status       IngredientRequestStatus @default(PENDING)
  mappedToId   String? // Ingredient.id once ops resolves it
  createdAt    DateTime                @default(now())

  @@index([status])
}

// ─── Meal Planning ────────────────────────────────────────────────────────────

enum MealPlanStatus {
  IDLE
  GENERATING
  READY
  FAILED
}

model Menu {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recipeId    String
  recipe      Recipe    @relation(fields: [recipeId], references: [id])
  mealTypeId  String?
  mealType    MealType? @relation(fields: [mealTypeId], references: [id])
  date        DateTime
  planVersion Int       @default(0)
  createdAt   DateTime  @default(now())

  restaurantPlanExchange RestaurantPlanExchange?
  fridgePlanExchange     FridgePlanExchange?

  @@index([patientId, planVersion, date])
}

// ─── Plan Exchanges (spec 2026-07-30-plan-exchanges-design.md) ───────────────
// Day-scoped overlay rows; Menu rows are never mutated. Two tables — two
// features flowing into one plan. displacedMenuId is @unique per table;
// cross-table single-displacement is enforced in the resolve transaction.
// CANCELLED rows must null displacedMenuId so the unique slot is freed.

enum PlanExchangeStatus {
  PENDING
  RESOLVED
  CANCELLED
}

model RestaurantPlanExchange {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  localDate   String // "YYYY-MM-DD" local calendar date (MealLog convention)
  planVersion Int // patient.activePlanVersion at creation
  status      PlanExchangeStatus @default(PENDING)

  displacedMenuId String? @unique
  displacedMenu   Menu?   @relation(fields: [displacedMenuId], references: [id], onDelete: SetNull)

  servings Float @default(1)

  // Provenance + display; macros are a SERVER-PRICED whole-dish snapshot
  // (RestaurantDish macros are whole-dish, not per-serving) stored unrounded.
  restaurantDishId String?
  restaurantDish   RestaurantDish? @relation(fields: [restaurantDishId], references: [id], onDelete: SetNull)
  name             String
  restaurantName   String
  calories         Float?
  protein          Float?
  carbs            Float?
  fat              Float?
  fiber            Float?
  incomplete       Boolean         @default(false) // any macro null at snapshot time

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([patientId, planVersion, localDate, status])
}

model FridgePlanExchange {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  localDate   String
  planVersion Int
  status      PlanExchangeStatus @default(PENDING)

  displacedMenuId String? @unique
  displacedMenu   Menu?   @relation(fields: [displacedMenuId], references: [id], onDelete: SetNull)

  servings Float @default(1)

  // Full client-supplied snapshot — the generated recipe exists nowhere else.
  fridgeRecipeId  String? // opaque provenance
  name            String
  emoji           String?
  mealType        String?
  usesIngredients String[]
  steps           String[]
  calories        Float
  protein         Float
  carbs           Float
  fat             Float
  fiber           Float

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([patientId, planVersion, localDate, status])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  patientId   String
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status      OrderStatus @default(PENDING)
  totalAmount Float?
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERED
  CANCELED
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name     String
  quantity Int
  price    Float?
}

// ─── Journal & Tracking ───────────────────────────────────────────────────────

model JournalEntry {
  id            String        @id @default(cuid())
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date          DateTime
  mood          String?
  weight        Float?
  energyLevel   String?
  activityLevel String?
  notes         String?
  meals         JournalMeal[]
  createdAt     DateTime      @default(now())

  @@index([patientId, date])
}

model JournalMeal {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  mealType       String
  preparation    String?
  recipeId       String?
  skipped        Boolean      @default(false)
  rating         Float?

  @@index([journalEntryId])
}

model Supplement {
  id        String             @id @default(cuid())
  patientId String
  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  dosage    String?
  timeSlot  String // "MORNING" | "AFTERNOON" | "EVENING"
  deletedAt DateTime? // soft delete: past journal days keep showing real intakes
  createdAt DateTime           @default(now())
  intakes   SupplementIntake[]

  @@index([patientId])
}

model SupplementIntake {
  id           String     @id @default(cuid())
  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  patientId    String // scalar copy for range queries; cascade rides the supplement relation
  date         DateTime // local midnight, journal-style
  createdAt    DateTime   @default(now())

  @@unique([supplementId, date])
  @@index([patientId, date])
}

enum MealLogSource {
  MANUAL // typed/edited by hand (web or iOS)
  RECIPE // logged from an existing Recipe row (incl. meal-plan dishes)
  PICTURE // one-tap from a Picture Mode vision result
  FRIDGE // "I cooked this" on a Fridge Mode generated recipe
  CUSTOM // from a PatientCustomIngredient (premium)
  RESTAURANT // "Add to today" from a restaurant menu dish
  CLARA // logged by Clara from chat (S1) — Clara's stated estimate is the snapshot
}

model MealLog {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Client-supplied LOCAL calendar date, "YYYY-MM-DD". Aggregation key.
  // Stored as a string on purpose: no Date hydration, no UTC math, immune to T3.
  // REQUIRED on every write; the server never defaults it.
  localDate String
  mealType  String // "breakfast" | "lunch" | "dinner" | "snack"
  source    MealLogSource @default(MANUAL)
  name      String // display label snapshot, always present

  // PER-SERVING snapshot captured at log time. Never recomputed from Recipe.
  // Stored UNROUNDED (full float precision); r1 rounding happens only at the
  // response/display boundary, so servings × per-serving always re-sums exactly.
  servings   Float   @default(1)
  calories   Float?
  protein    Float?
  carbs      Float?
  fat        Float?
  fiber      Float?
  incomplete Boolean @default(false) // true when any macro was unpriceable (null→0)

  // Provenance only — NEVER read for macro math.
  recipeId           String?
  recipe             Recipe?         @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  restaurantDishId   String?
  restaurantDish     RestaurantDish? @relation(fields: [restaurantDishId], references: [id], onDelete: SetNull)
  customIngredientId String?
  journalMealId      String? // best-effort provenance pointer to a plan-completion
  // JournalMeal row. Plain nullable column, deliberately
  // NOT unique: the same planned dish eaten twice yields
  // two intake rows pointing at one completion row.
  pictureResultId    String? // opaque id echoed by Picture Mode
  fridgeRecipeId     String? // opaque id of the generated Fridge recipe
  planExchangeId     String? // id of a RestaurantPlanExchange or FridgePlanExchange
  // row this intake fulfills. Plain provenance (no FK — two possible tables);
  // NEVER read for macro math. Presence of such a log = the exchange is eaten.

  note            String?
  clientRequestId String? // idempotency key for one-tap / offline replay;
  // ALSO an alternate address for PATCH/DELETE (see routes)
  deletedAt       DateTime? // soft delete → tombstone for cross-device sync
  loggedAt        DateTime  @default(now()) // ordering within a day
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([patientId, clientRequestId]) // Postgres treats NULLs as distinct → manual logs unaffected
  @@index([patientId, localDate]) // hot day/range aggregation
  @@index([patientId, updatedAt]) // delta sync for iOS
}

// ─── Reference Data ───────────────────────────────────────────────────────────

model Company {
  id       String    @id @default(cuid())
  name     String    @unique
  accounts Account[]
}

model Country {
  id       String    @id @default(cuid())
  name     String    @unique
  code     String    @unique
  accounts Account[]
}

// ─── Coupon System ────────────────────────────────────────────────────────────

enum CouponType {
  ADMIN // grants SUPER role — full unlimited access, no payment
  PREMIUM // upgrades subscription to PREMIUM without payment
}

model Coupon {
  id          String             @id @default(cuid())
  code        String             @unique
  type        CouponType         @default(PREMIUM)
  maxUses     Int                @default(1)
  usedCount   Int                @default(0)
  expiresAt   DateTime?
  isActive    Boolean            @default(true)
  note        String?
  createdAt   DateTime           @default(now())
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  redeemedAt DateTime @default(now())

  @@unique([couponId, accountId])
}

model TermsAndConditions {
  id        String   @id @default(cuid())
  content   String
  version   String   @unique
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ZipCode {
  id      String  @id @default(cuid())
  code    String  @unique
  city    String?
  state   String?
  country String?
  active  Boolean @default(true)
}

// ─── Clara capability-gap ledger ──────────────────────────────────────────────

enum ClaraGapCategory {
  LOGS
  NUTRITION
  MEAL_PLAN
  JOURNAL
  SUPPLEMENTS
  FILTERS
  GROCERY
  RESTAURANTS
  FRIDGE
  EXCHANGES
  PROGRESS
  TASTE
  CUSTOM_INGREDIENTS
  BODY_GOALS
  OTHER
}

enum ClaraGapReason {
  NOT_BUILT
  FLAGGED_OFF
  OUT_OF_SCOPE
  UNCLEAR
}

/// One recorded "Clara could not do that" event. Demand data that decides which
/// skill cycle runs next (spec 2026-07-30-clara-full-service-assistant §5).
/// Stores a model-written PARAPHRASE only — never the raw transcript.
/// Retention: 180 days.
model ClaraCapabilityRequest {
  id        String           @id @default(cuid())
  patientId String
  patient   Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category  ClaraGapCategory
  reason    ClaraGapReason   @default(NOT_BUILT)
  summary   String
  surface   String           @default("unknown")
  /// Client-local day, "YYYY-MM-DD" — the dedupe axis.
  localDate String
  createdAt DateTime         @default(now())

  /// One row per user per category per day: ranking counts people, not volume.
  @@unique([patientId, category, localDate])
  @@index([category, createdAt])
}
