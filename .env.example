# ─── Wondish environment variables ───────────────────────────────────────────
# Copy to `.env` and fill in real values. Never commit the real `.env`.

# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Pooled connection (PgBouncer) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct connection — used by Prisma for migrations / db push (schema.prisma directUrl).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ─── AI (Anthropic — dish-checker) ───────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Storage (AWS S3 — image uploads) ────────────────────────────────────────
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-bucket-name"

# ─── Payments (Stripe) ───────────────────────────────────────────────────────
# Clara iOS Phase 2, Task 1 (GET/DELETE /api/me) hand-off: no new env key is
# required here — it reuses CLERK_SECRET_KEY (above) and DATABASE_URL /
# STRIPE_SECRET_KEY (this section). The APPLE_IAP_* keys (App Store Connect
# API key, shared secret, etc.) for the Apple IAP reconciliation surface land
# with Task 6, not this task.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Premium price: set the price ID directly, or resolve it from a lookup key.
STRIPE_PREMIUM_PRICE_ID="price_..."
STRIPE_PRICE_LOOKUP_KEY="premium_monthly"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Rate limiting (Upstash Redis) ───────────────────────────────────────────
# Create a free Redis DB at https://console.upstash.com → REST API tab.
# Also backs Stripe webhook idempotency. If unset, both fall back to a
# per-instance in-memory limiter / no-op dedupe (dev only).
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# ─── Observability (Sentry) ──────────────────────────────────────────────────
# If unset, Sentry is disabled (no-ops). DSN is safe to expose (public).
NEXT_PUBLIC_SENTRY_DSN="https://...@oXXXX.ingest.sentry.io/XXXX"
# Optional — only needed for source-map upload during CI builds.
SENTRY_ORG="your-org"
SENTRY_PROJECT="your-project"
SENTRY_AUTH_TOKEN=""

# ─── Clara skill runtime ─────────────────────────────────────────────────────
# Allow-list of ACTIVE product skills, comma-separated (e.g. "profile,logs").
#   unset        ⇒ every registered product skill is active (the default)
#   empty string ⇒ kill switch: no product skills, Clara answers with no tools
# gap_report is runtime-owned and stays on regardless of this value, so you keep
# learning what users asked for even while a skill is switched off.
CLARA_SKILLS=

# Secret for the retention cron (GET /api/cron/clara-gap-purge, Bearer token).
# Unset ⇒ the endpoint refuses to run.
CRON_SECRET=""
